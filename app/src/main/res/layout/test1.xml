<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/main">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/title"
            android:background="@android:color/holo_red_light"
            android:textColor="@android:color/white"
            android:textAlignment="center"
            android:textSize="25sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:id="@+id/members"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/members"
            android:layout_margin="10sp"
            android:textStyle="bold"
            android:textSize="20sp"
            >
        </TextView>

        <TextView
            android:id="@+id/lcontract"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10sp"
            android:text="@string/header"
            android:textAlignment="center"
            android:textSize="25sp"
            android:textStyle="bold">

        </TextView>
        <!-- Kacey learning contract -->
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/Kacey"
            android:textColor="@color/white"
            android:background="@color/gray"
            android:textAlignment="center"
            android:textSize="20sp"
            android:layout_margin="10sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:id="@+id/contents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/content1"
            android:textAlignment="viewStart"
            android:layout_margin="10sp"
            android:textSize="18sp"
            android:textStyle="bold">
        </TextView>

        <!-- Ivan learning contract -->
        <TextView
            android:id="@+id/ivan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/Ivan"
            android:textColor="@color/white"
            android:background="@color/gray"
            android:textAlignment="center"
            android:textSize="20sp"
            android:layout_margin="10sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/content2"
            android:textAlignment="viewStart"
            android:layout_margin="10sp"
            android:textSize="18sp"
            android:textStyle="bold">
        </TextView>

        <!-- Brent learning contract -->
        <TextView
            android:id="@+id/brent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/Brent"
            android:textColor="@color/white"
            android:background="@color/gray"
            android:textAlignment="center"
            android:textSize="20sp"
            android:layout_margin="10sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/content3"
            android:textAlignment="viewStart"
            android:layout_margin="10sp"
            android:textSize="18sp"
            android:textStyle="bold">
        </TextView>

    </LinearLayout>

</ScrollView>