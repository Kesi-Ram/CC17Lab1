<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/main">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/laboratory_activity_1_nlearning_contract_application"
            android:background="@android:color/holo_red_light"
            android:textColor="@android:color/white"
            android:textAlignment="center"
            android:textSize="25sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:id="@+id/members"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/members_group_name_n_aquino_n_collado_n_codiamat_n_mendiola_n_sangbaan"
            android:layout_margin="10sp"
            android:textStyle="bold"
            android:textSize="20sp"
            >
        </TextView>

        <TextView
            android:id="@+id/lcontract"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10sp"
            android:text="@string/learning_contract"
            android:textAlignment="center"
            android:textSize="25sp"
            android:textStyle="bold">

        </TextView>
        <!-- Kacey learning contract -->
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/kacey_royce_tyne_sangbaan"
            android:textAlignment="viewStart"
            android:layout_margin="10sp"
            android:textSize="18sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:id="@+id/contents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/i_expectations_n_n1_i_expect_to_learn_new_things_n2_i_expect_to_have_more_knowledge_about_information_systems_n3_i_expect_to_use_the_things_i_learn_here_for_our_capstone_n4_i_expect_my_teacher_to_have_patience_in_teaching_this_course_n5_i_also_expect_my_classmates_to_be_helpful_n_nii_contribution_n_n1_to_collaborate_n2_to_attend_classes_n3_to_participate_in_activities_n4_exert_enough_effort_to_pass_n5_to_help_my_classmates_when_they_are_having_a_hard_time_and_i_am_understanding_the_lesson_n_niii_motivations_n_n1_high_tuition_n2_my_loved_ones_n3_the_importance_of_this_course_to_my_future_n4_to_gain_more_knowledge_n5_finishing_this_course_n_niv_hindrances_n_n1_laziness_n2_lack_of_prior_knowledge_n3_easily_getting_uninterested_or_a_sense_of_ennui_n4_getting_easily_tired_when_there_s_a_lot_of_activities_n5_sometimes_being_late_because_of_staying_up_all_night"
            android:textAlignment="viewStart"
            android:layout_margin="10sp"
            android:textSize="18sp"
            android:textStyle="bold">
        </TextView>

        <!-- Ivan learning contract -->
        <TextView
            android:id="@+id/ivan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ivan_dave_mendiola"
            android:textAlignment="viewStart"
            android:layout_margin="10sp"
            android:textSize="18sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/expectations_1_i_expect_that_this_subject_will_be_fun_and_engaging_2_i_expect_to_gain_a_deep_understanding_of_how_to_create_an_application_3_i_expect_to_learn_the_rules_about_what_is_the_best_tech_stack_for_developing_an_application_4_i_expect_the_lessons_to_be_a_little_bit_hard_5_i_expect_to_practice_using_real_tools_that_app_development_professionals_use_every_day_contributions_1_i_can_contribute_what_i_know_about_this_course_to_my_classmates_2_i_will_actively_participate_in_activities_3_i_will_help_others_when_needed_4_i_will_actively_listen_to_discussions_5_i_will_pass_everything_on_time_motivations_1_i_want_to_build_a_stable_and_successful_career_for_my_future_2_i_am_working_hard_so_i_can_earn_good_money_later_on_3_i_want_to_succeed_so_i_can_keep_up_with_and_support_my_friends_4_i_want_to_make_my_family_proud_of_my_achievements_5_i_need_to_do_well_to_make_sure_my_tuition_is_a_good_investment_hindrances_1_i_often_feel_tired_in_class_because_of_a_lack_of_sleep_2_my_bad_body_clock_makes_it_hard_to_stay_awake_during_early_lessons_3_i_find_it_difficult_to_stay_on_track_because_i_have_a_hard_time_focusing_4_i_sometimes_struggle_to_start_my_work_because_of_laziness_5_i_tend_to_leave_my_assignments_until_the_last_minute_due_to_procrastination"
            android:textAlignment="viewStart"
            android:layout_margin="10sp"
            android:textSize="18sp"
            android:textStyle="bold">
        </TextView>






    </LinearLayout>

</ScrollView>